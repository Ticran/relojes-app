# Puerto en el que escucha el servidor
# Cambiar solo en entornos donde el puerto no sea el 3000
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# Configuración de la base de datos (PostgreSQL)
# Reemplaza usuario, contraseña, host, puerto y nombre de BD según tu entorno.
# Nunca subas este archivo con credenciales reales (.env está en .gitignore).
DATABASE_URL=

# Orígenes permitidos para CORS (lista separada por comas).
# En desarrollo, si no se define, se permite únicamente http://localhost:5173.
# En producción es obligatoria y se exige explícitamente.
CORS_ORIGIN=http://localhost:5173

# Configuración de Cloudinary (opcional; solo necesaria para carga de imágenes).
# Si no se definen, el backend inicia normalmente y la carga de imágenes
# responderá con un error controlado al intentarse usar.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
